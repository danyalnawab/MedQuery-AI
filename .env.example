# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# docker compose reads this file automatically for variable substitution.

# REQUIRED. Used by the FastAPI backend for OpenAI embeddings + chat completions.
OPENAI_API_KEY=sk-your-key-here

# OPTIONAL. Comma-separated browser origins allowed to call the backend directly (CORS).
# The bundled setup proxies through the frontend, so you usually don't need this.
# ALLOWED_ORIGINS=http://localhost:3000
