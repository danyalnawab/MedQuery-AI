.github
.gitignore

# Python local envs / caches
venv
.venv
**/__pycache__
**/*.pyc
.pytest_cache

# Secrets & local env files (passed in at runtime instead)
.env
.env.*
backend/.env

# Not needed in the backend image
frontend
data
docs
devlog.md
*.md
create_database.py
query_data.py
requirements.txt

